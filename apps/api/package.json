    "@types/node": "^24.3.0",
    "better-auth": "^1.6.27",
    "bullmq": "^5.41.6",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "ioredis": "^5.5.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@stackaudit/eslint-config": "workspace:*",
