# Application
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/stackaudit?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:4000"

# GitHub OAuth
# Create an OAuth App at: https://github.com/settings/developers
# Set Authorization callback URL to: http://localhost:4000/api/auth/callback/github
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"