generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Better Auth Tables ─────────────────────────────
// These tables follow the Better Auth schema requirements.
// Do NOT rename columns — Better Auth maps to these exact names.

model user {
  id            String    @id @default(uuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      session[]
  accounts      account[]

  profile       developer_profile?
  issueMatches  issue_match[]

  @@map("users")
}

model session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   user   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

model account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  user      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("accounts")
}

model verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verifications")
}

// ─── StackAudit Core Tables ─────────────────────────



model developer_profile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // -- OBSERVED (from GitHub directly) --
  githubLogin       String?              // GitHub username
  observedLanguages String[]             // e.g., ["TypeScript", "Python"]
  recentLanguages   String[]             // Languages from repos pushed in last 6 months
  publicRepoCount   Int      @default(0)
  totalContributions Int     @default(0)
  githubBio         String?
  githubCompany     String?
  githubLocation    String?
  repositoryTopics  String[]             // Aggregated topics from user's repos

  // -- ENRICHED (from deeper GitHub API calls) --
  languageBytes     Json?                // e.g., { "TypeScript": 284000, "Python": 52000 }
  commitCount       Int      @default(0)
  prCount           Int      @default(0)
  issueCount        Int      @default(0)
  reviewCount       Int      @default(0)
  lastActiveAt      DateTime?

  // -- INFERRED (derived by StackAudit) --
  // Use JSON to store complex mappings like { "TypeScript": "Advanced", "Python": "Intermediate" }
  inferredSkills    Json?    

  // -- USER-CONFIRMED (Intent & Preferences) --
  currentFocus      String[] // e.g., ["Java", "Spring Boot"]
  learningGoals     String[] // e.g., ["REST APIs", "Testing"]
  preferredArea     String?  // e.g., "Backend"
  preferredComplexity String? // e.g., "Intermediate"
  preferredContributionTypes String[] // e.g., ["Bug fix", "Feature"]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("developer_profiles")
}

model issue_match {
  id              String   @id @default(uuid())
  userId          String
  user            user     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  repository      String   // e.g., "facebook/react"
  issueNumber     Int
  issueTitle      String
  issueUrl        String
  
  // -- Link to raw issue data --
  githubIssueId   String?
  githubIssue     github_issue? @relation(fields: [githubIssueId], references: [id])
  
  // -- V1 Deterministic Search Signals --
  complexity      String?  // e.g. "Good First Issue", "Intermediate"
  contributionType String? // e.g. "Bug Fix", "Feature"
  technologies    String[] // e.g. ["React", "TypeScript"]
  
  // -- Matching --
  matchScore      Int?     // Deterministic or combined score 0-100
  
  // -- AI Explanation Layer --
  matchReason     String?  // AI explanation of why it fits the dev
  missingSignals  String?  // What appears to be missing or challenging
  learningRelevance String? // What they will learn from this
  
  // -- Structured Matching Output --
  reasons         String[] // Deterministic reasons (e.g. "TypeScript matches your experience")
  gaps            String[] // Deterministic gaps (e.g. "Low PR acceptance rate")
  
  status          String   @default("DISCOVERED") // DISCOVERED, VIEWED, SAVED, DISMISSED
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, githubIssueId])
  @@index([userId])
  @@index([repository])
  @@index([githubIssueId])
  @@map("issue_matches")
}

// ─── GitHub Issue Data ──────────────────────────────
// Raw issue data stored independently of user matches.
// Multiple users can match the same issue without duplicating data.

model github_issue {
  id              String   @id @default(uuid())
  
  // -- Identity --
  githubId        BigInt   @unique       // GitHub's issue ID
  repository      String                 // "owner/repo"
  issueNumber     Int
  
  // -- Content --
  title           String
  body            String?                // Issue body/description (truncated)
  url             String                 // html_url
  
  // -- State --
  state           String                 // "open", "closed"
  issueCreatedAt  DateTime               // GitHub's created_at
  issueUpdatedAt  DateTime               // GitHub's updated_at
  closedAt        DateTime?
  
  // -- Raw Signals --
  labels          String[]               // All label names
  commentsCount   Int      @default(0)
  reactionsTotal  Int      @default(0)
  assigneeCount   Int      @default(0)
  linkedPrCount   Int      @default(0)
  
  // -- Repository Context --
  repoLanguage    String?                // Primary language of the repo (legacy, kept for backward compat)
  repoLanguages   Json?                  // Full language breakdown: { "Java": 150000, "HTML": 80000 }
  repoTopics      String[]               // Repository topics: ["react", "nextjs", "api"]
  repoDescription String?                // Repository description text
  repoStars       Int      @default(0)
  repoOpenIssues  Int      @default(0)
  repoActivityLevel String?              // "active", "moderate", "low", "inactive"
  repoLastPushedAt  DateTime?
  repoLastUpdatedAt DateTime?
  repoPrAcceptanceRate Float?            // 0-100% acceptance rate
  
  // -- Derived Signals (computed on ingest) --
  staleness         String?              // "fresh", "aging", "stale", "abandoned"
  activityLevel     String?              // "active", "moderate", "low", "dead"
  difficultyEstimate String?             // "beginner", "intermediate", "advanced"
  issueType         String?              // "bug", "feature", "docs", "refactor", "unknown"
  isGoodFirstIssue  Boolean  @default(false)
  isHelpWanted      Boolean  @default(false)
  
  // -- Metadata --
  ingestedAt      DateTime @default(now())
  lastSyncedAt    DateTime @default(now())
  
  // -- Relations --
  matches         issue_match[]
  
  @@unique([repository, issueNumber])
  @@index([repository])
  @@index([repoLanguage])
  @@index([difficultyEstimate])
  @@index([staleness])
  @@index([state])
  @@index([state, staleness, difficultyEstimate])
  @@map("github_issues")
}